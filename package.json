{
  "name": "motion-studio-skill",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime local da Agent Skill Motion Studio Pro para criação, edição e animação 2D/3D.",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "doctor": "node scripts/motion-studio.mjs doctor",
    "acceptance": "node scripts/render-acceptance.mjs",
    "batch": "node scripts/batch-manager.mjs run"
  },
  "dependencies": {
    "@react-three/fiber": "9.1.2",
    "@remotion/cli": "4.0.545",
    "@remotion/three": "4.0.545",
    "@types/three": "0.171.0",
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "three": "0.171.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
