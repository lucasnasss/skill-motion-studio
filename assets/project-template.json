{
  "version": "1.0",
  "title": "Novo vídeo",
  "prompt": "Descreva aqui o vídeo desejado.",
  "objective": "Comunicar uma ideia com clareza em poucos segundos.",
  "audience": "Público geral",
  "language": "pt-BR",
  "theme": "minimal",
  "video": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safeMarginPct": 0.07
  },
  "captions": {
    "enabled": true,
    "burnIn": false,
    "position": "bottom"
  },
  "assets": {
    "attributions": []
  },
  "scenes": [
    {
      "id": "intro",
      "durationSeconds": 5,
      "transition": {"type": "fade", "durationSeconds": 0.5},
      "narration": "Novo vídeo.",
      "elements": [
        {
          "id": "title",
          "type": "text",
          "x": 0.12,
          "y": 0.3,
          "width": 0.76,
          "height": 0.3,
          "text": "Novo vídeo",
          "role": "title",
          "align": "center",
          "verticalAlign": "center",
          "enter": {"preset": "slide-up", "durationSeconds": 0.7}
        }
      ]
    }
  ]
}
